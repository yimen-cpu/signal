# 飞书应用（机器人）
APP_ID=cli_xxx
APP_SECRET=xxx

# Meego / 飞书项目开放平台插件
MEEGO_BASE_URL=https://meego.larkoffice.com
MEEGO_PLUGIN_ID=MII_xxx
MEEGO_PLUGIN_SECRET=xxx
MEEGO_USER_KEY=xxx

# 目标空间与工作项
MEEGO_PROJECT_KEY=your_project_key
MEEGO_WORK_ITEM_TYPE_KEY=story
MEEGO_TEMPLATE_ID=123456789

# 可选：描述字段。配置后，命令第二行起的内容会写入该字段
MEEGO_DESCRIPTION_FIELD_KEY=

# 可选：其他必填字段，结构以“创建工作项元数据”接口为准
MEEGO_DEFAULT_FIELDS_JSON=[]

# 可选：创建成功后的详情页链接模板
MEEGO_ITEM_URL_TEMPLATE=https://meego.larkoffice.com/{project_key}/{work_item_type_key}/detail/{work_item_id}
